{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "baseline_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "minItems": 1,
      "maxItems": 2000
    },
    "existing_implementation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "missing_functionality": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "architectural_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "testing_assessment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "dependencies_and_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "delivery_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor": {
            "type": "string",
            "enum": [
              "requirements",
              "architecture",
              "implementation",
              "testability",
              "database_migrations",
              "authentication",
              "external_infrastructure",
              "production_risk",
              "cross_feature_dependencies",
              "active_development_conflicts"
            ]
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "uncertain": {
            "type": "boolean"
          }
        },
        "required": [
          "factor",
          "assessment",
          "uncertain"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    },
    "suitability": {
      "type": "string",
      "enum": [
        "suitable",
        "suitable_with_constraints",
        "requires_human_decision",
        "blocked",
        "already_satisfied"
      ]
    },
    "suitability_explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 200
    },
    "recommended_next_action": {
      "type": "string",
      "enum": [
        "No implementation needed.",
        "Further investigation required.",
        "Human decision required.",
        "Suitable for autonomous implementation."
      ]
    },
    "executed_verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 0
    },
    "remote_freshness": {
      "type": "string",
      "const": "not_checked"
    },
    "other_branches_examined": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 0
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "baseline_commit",
    "executive_summary",
    "criteria",
    "existing_implementation",
    "missing_functionality",
    "architectural_constraints",
    "testing_assessment",
    "dependencies_and_risks",
    "contradictions",
    "delivery_factors",
    "suitability",
    "suitability_explanation",
    "constraints",
    "recommended_next_action",
    "executed_verification",
    "remote_freshness",
    "other_branches_examined"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-agent:investigation:1",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 0,
          "maxLength": 12000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "enum": [
            "static_implementation",
            "test_coverage",
            "documentation"
          ]
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end",
        "symbol",
        "quote",
        "kind"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "repository_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "text",
        "source_ids",
        "repository_evidence"
      ],
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "partially_satisfied",
            "not_satisfied",
            "unable_to_verify",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "runtime_verified": {
          "type": "boolean",
          "const": false
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "requirement_id",
        "requirement",
        "status",
        "evidence",
        "tests",
        "gaps",
        "uncertainties",
        "confidence",
        "runtime_verified",
        "explanation"
      ],
      "additionalProperties": false
    }
  }
}
